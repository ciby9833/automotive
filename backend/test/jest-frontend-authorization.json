{
  "rootDir": "../..",
  "roots": ["<rootDir>/backend/test", "<rootDir>/frontend/src"],
  "testEnvironment": "node",
  "testMatch": ["<rootDir>/backend/test/frontend-authorization.spec.ts"],
  "moduleNameMapper": { "^@/(.*)$": "<rootDir>/frontend/src/$1" },
  "transform": {
    "^.+\\.tsx?$": [
      "<rootDir>/backend/node_modules/ts-jest",
      { "tsconfig": "<rootDir>/backend/tsconfig.json" }
    ]
  }
}
