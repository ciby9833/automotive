{
  "rootDir": "../..",
  "roots": [
    "<rootDir>/backend/test",
    "<rootDir>/frontend/src"
  ],
  "testEnvironment": "node",
  "testMatch": [
    "<rootDir>/backend/test/frontend-authorization.spec.ts",
    "<rootDir>/backend/test/frontend-live-refresh.spec.ts",
    "<rootDir>/backend/test/frontend-live-hook.spec.ts"
  ],
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/frontend/src/$1"
  },
  "transform": {
    "^.+\\.tsx?$": [
      "<rootDir>/backend/node_modules/ts-jest",
      {
        "tsconfig": "<rootDir>/backend/tsconfig.json"
      }
    ]
  }
}
