# 生产 PG 镜像：TimescaleDB + PostGIS 一起打
#
# 背景
#   TimescaleDB 官方镜像基于 Alpine，不带 postgis；
#   Postgis 官方镜像基于 Debian，不带 timescaledb。
#   我们两个扩展都要（GPS 轨迹时序表用 timescale, yards.location 用 postgis），
#   所以在 timescale 基础上 apk add postgis 一次打进去。
#
# Build
#   docker build -f Dockerfile.timescale-postgis -t tms-timescale-postgis:2.17.2-pg17 .
# 或者由 docker-compose.prod.yml 里的 build 段自动完成
FROM timescale/timescaledb:2.17.2-pg17

USER root

RUN set -eux; \
    apk add --no-cache postgis; \
    mkdir -p /usr/local/share/postgresql/extension; \
    mkdir -p /usr/local/lib/postgresql; \
    cp -a /usr/share/postgresql17/extension/. /usr/local/share/postgresql/extension/; \
    cp -a /usr/lib/postgresql17/. /usr/local/lib/postgresql/

USER postgres